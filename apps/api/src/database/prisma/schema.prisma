// ─── Enums: foundation (Phase 1 — money, metrics, verification, trust) ──

// All money fields are amount + currency (never a bare number) — CLAUDE.md §7:
// everything defaults to INR; USD kept only for the rare cross-border case.
enum Currency {
  INR
  USD
}

// V0=self-declared, V1=document+admin-reviewed, V2=auto-pulled from a real
// source or two-sided confirmation, V3=verified against a government/official
// registry. Trust Score rises only through V1-V3, never V0 — see trust-model.ts.
enum VerificationTier {
  V0
  V1
  V2
  V3
}

enum VerificationRecordStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  DISPUTED
}

// What a MetricObservation row is measuring — every metric that changes over
// time is stored as history under one of these keys, never overwritten in place.
enum MetricKey {
  MONTHLY_REVENUE
  ARR
  MRR
  TOTAL_USERS
  TOTAL_CUSTOMERS
  DOWNLOADS
  TEAM_SIZE
  VALUATION
  FUNDING_RAISED
  RETENTION_RATE_PERCENT
  GROWTH_RATE_PERCENT
  MONTHLY_BURN_RATE
}

// Stage is normalized as three independent axes rather than one label — a
// bootstrapped company at real revenue and a pre-revenue company that raised a
// big seed are not the same thing. See Startup.productStatus/revenueStatus/fundingStatus.
enum ProductStatus {
  CONCEPT
  PROTOTYPE
  BETA
  LIVE
  SCALED
}

enum RevenueStatus {
  NONE
  PILOT
  FIRST_REVENUE
  RECURRING
  PROFITABLE
}

enum FundingStatus {
  BOOTSTRAPPED
  ANGEL
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C_PLUS
  PE
  PUBLIC
}

enum TrustBand {
  STARTING
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// ─── Enums: two-sided confirmation (Phase 2) ─────────────────────────────

// What kind of relationship is being claimed — spec §9: any claim about a
// relationship must be confirmed by the OTHER party, or it counts for zero trust.
enum RelationshipType {
  PORTFOLIO_INVESTMENT // Investor <-> Startup: "I invested in this startup"
  LEAD_INVESTOR // Investor <-> Startup: claimed as the lead of a round
  BOARD_SEAT // Investor <-> Startup
  INCUBATOR_ALUMNUS // IncubatorProfile <-> Startup: "this startup went through our program"
  UNIVERSITY_SPINOUT // UniversityProfile <-> Startup
  STRATEGIC_PARTNER // Startup <-> Startup, or Startup <-> any org
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  DENIED
}

// ─── Enums: Phase 6 — permission/privacy ─────────────────────────────────

// Bundle 30 — "founders share real data only if they control who sees it."
// Additive to `isPublic` (which still gates search/discovery inclusion as it
// always has); this is the finer-grained control layer on top.
enum ProfileVisibility {
  PUBLIC
  INVESTOR_ONLY
  PRIVATE
  STEALTH
}

// Bundle 30/11 — "show revenue publicly only as a BAND... never exact
// figures" is the default; a founder can loosen or tighten it per profile.
enum MetricVisibility {
  EXACT
  BAND
  HIDDEN
}

// ─── Enums: Phase 4 — funding rounds & document data room ───────────────

enum FundingInstrument {
  EQUITY
  SAFE
  CCPS
  DEBT
  GRANT
}

// Fixed taxonomy replacing free-text industry — discovery filters and stage
// mandates depend on comparable categories, not typed strings.
enum Industry {
  FINTECH
  HEALTHTECH
  EDTECH
  AGRITECH
  ECOMMERCE
  SAAS
  DEEPTECH
  AI_ML
  LOGISTICS
  MOBILITY
  REAL_ESTATE
  MEDIA_ENTERTAINMENT
  GAMING
  CLEANTECH_CLIMATE
  FOODTECH
  RETAIL_D2C
  TRAVEL_HOSPITALITY
  HR_TECH
  LEGAL_TECH
  INSURTECH
  SPACE_TECH
  MANUFACTURING
  CONSTRUCTION_PROPTECH
  SOCIAL_IMPACT
  ADTECH
  CYBERSECURITY
  WEB3_BLOCKCHAIN
  OTHER
}

// ─── Identity & auth ────────────────────────────────────────────────────

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  passwordHash       String? // null for OAuth-only accounts
  fullName           String
  avatarUrl          String?
  role               UserRole
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime? // set once by PhoneVerificationService after a real OTP confirm — never by typing a number, see UserProfile.mobileNumber
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String? // encrypted at rest by the app layer, never returned by any endpoint
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime? // soft delete — preserves FK history for audit logs

  profile             UserProfile?
  startup             Startup?
  investorProfile     Investor?
  mentorProfile       MentorProfile?
  incubatorProfile    IncubatorProfile?
  universityProfile   UniversityProfile?
  serviceProviderProfile ServiceProviderProfile?
  jobSeekerProfile    JobSeekerProfile?
  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  documents           Document[]
  notifications       Notification[]
  sentConnections     Connection[]        @relation("ConnectionRequester")
  receivedConnections Connection[]        @relation("ConnectionRecipient")
  sentMessages        Message[]           @relation("MessageSender")
  subscription        Subscription?
  auditLogs           AuditLog[]
  startupFollows      StartupFollow[]
  startupProfileViews StartupProfileView[]
  pipelineEntries     PipelineEntry[]
  investments         Investment[]
  sentMentorBookings     MentorBookingRequest[] @relation("MentorBookingFounder")
  receivedMentorBookings MentorBookingRequest[] @relation("MentorBookingMentor")
  jobApplications        JobApplication[]
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  pollVotes              PollVote[]
  eventRsvps             EventRsvp[]
  postBookmarks          PostBookmark[]
  sentFollows            Follow[] @relation("Follower")
  receivedFollows        Follow[] @relation("Following")
  founderReviewsGiven    FounderReview[] @relation("FounderReviewMentor")
  founderReviewsReceived FounderReview[] @relation("FounderReviewFounder")
  mentorReviewsGiven     MentorReview[] @relation("MentorReviewFounder")
  mentorReviewsReceived  MentorReview[] @relation("MentorReviewMentor")
  documentGrantsReceived DocumentGrant[] @relation("DocumentGrantRecipient")
  documentGrantsIssued   DocumentGrant[] @relation("DocumentGrantIssuer")
  documentViews          DocumentView[]
  investmentMandates     InvestmentMandate[]
  watchlistTriggers      WatchlistTrigger[]
  savedSearches          SavedSearch[]

  @@index([role])
  @@map("users")
}

// Shared "personal details" extension — every role's onboarding starts with
// this same form (Step 1 in the founder wizard, "Personal Details" in every
// other role's flow) before branching into role-specific fields, so these
// columns live once instead of being duplicated across seven profile tables.
model UserProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  mobileNumber   String?
  dateOfBirth    DateTime?
  gender         Gender?
  nationality    String?
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  city           String?
  state          String?
  country        String?
  bio            String?
  yearsOfExperience Int? // backs the "founder experience" discovery filter — see StartupsService.search

  // Onboarding wizard state — see docs/11-onboarding-architecture.md.
  // `onboardingDraft` accumulates every step's answers as JSON so autosave
  // never has to satisfy full relational constraints on a half-finished
  // wizard; `publish()` validates the complete draft and commits it into
  // the normalized tables below in one transaction.
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  onboardingStep   Int              @default(0)
  onboardingDraft  Json?
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String // "google" | "linkedin" | "github" | "apple" | "microsoft"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Doubles as the "session" record for the Session Management / Device List
// UI — one row per active refresh token, one refresh token per device/browser.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique // never store the raw token — see docs/09-authentication-security.md
  deviceLabel String? // parsed from User-Agent at issuance, e.g. "Chrome on macOS"
  userAgent   String?
  ipAddress   String?
  rememberMe  Boolean   @default(false) // short session (browser-close) vs. long-lived, see auth.service.ts
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Short-lived codes for email verification and login-time MFA (email fallback).
// TOTP MFA doesn't need this — it's verified against `User.twoFactorSecret` directly.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  purpose     OtpPurpose
  codeHash    String // SHA-256 of the 6-digit code — same "never store raw secrets" rule as refresh tokens
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0) // capped in service logic to blunt brute-force guessing
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

// Link-based reset (emailed URL), deliberately separate from OtpCode — see docs/09-authentication-security.md.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// One-time-use backup codes issued at MFA enrollment for account recovery if the authenticator device is lost.
model MfaRecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  codeHash String
  usedAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// Generic verification document, keyed to the uploading user rather than a
// specific profile table — every role's "Verification Documents" step
// (Startup Step 8, Investor, Mentor, ...) writes here uniformly.
model Document {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  type           DocumentType
  fileUrl        String
  fileName       String
  uploadedAt     DateTime     @default(now())
  verifiedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants DocumentGrant[]
  views  DocumentView[]

  @@index([userId])
  @@map("documents")
}

// Per-viewer permission on a gated document — Bundle 21's "permissioned data
// room": expiry (default 14 days), optional NDA gate, and this is what the
// view log (DocumentView) is keyed against. Granting is founder-initiated
// only; there's no public/investor-initiated request flow yet.
model DocumentGrant {
  id             String    @id @default(uuid()) @db.Uuid
  documentId     String    @db.Uuid
  grantedToId    String    @db.Uuid
  grantedById    String    @db.Uuid
  expiresAt      DateTime
  requireNda     Boolean   @default(false)
  ndaAcceptedAt  DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  grantedTo User     @relation("DocumentGrantRecipient", fields: [grantedToId], references: [id], onDelete: Cascade)
  grantedBy User     @relation("DocumentGrantIssuer", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([documentId, grantedToId])
  @@index([grantedToId])
  @@map("document_grants")
}

// "Blume opened your deck twice" — the view log a founder can see per
// gated document. One row per view (not deduped) so a founder can see
// genuine repeat-interest, not just first-open.
model DocumentView {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  viewerId   String   @db.Uuid
  viewedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  viewer   User      @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([documentId, viewedAt])
  @@map("document_views")
}

// ─── Startup domain ─────────────────────────────────────────────────────

model Startup {
  id                    String              @id @default(uuid()) @db.Uuid
  ownerId               String              @unique @db.Uuid
  name                  String
  slug                  String              @unique
  tagline               String
  description           String
  logoUrl               String?
  website               String?
  industry              Industry
  subIndustry           String? // free-text within the chosen Industry; a full sub-industry crosswalk is future work
  stage                 StartupStage        @default(IDEA) // computed/verified overall label — see productStatus/revenueStatus/fundingStatus below
  declaredStage         StartupStage? // founder's own self-reported label, kept separately per CLAUDE.md §10 (declared vs verified)
  productStatus         ProductStatus?
  revenueStatus         RevenueStatus?
  fundingStatus         FundingStatus?
  monthsInCurrentStage  Int?
  foundedYear            Int
  registrationStatus    RegistrationStatus  @default(NOT_REGISTERED)
  companyType           CompanyType?
  headquarters          String? // city/country the company is legally headquartered in
  businessModelSummary  String? // free-text model description (e.g. "subscription", "marketplace take-rate")
  mission               String?
  vision                String?
  problemStatement      String?
  solution              String?
  uniqueValueProposition String?
  teamSize              Int                 @default(1)
  hiringStatus          HiringStatus        @default(NOT_HIRING)
  openRoles             String[]
  location              String
  currency              Currency            @default(INR)
  fundingRaisedAmount   Decimal             @default(0) @db.Decimal(14, 2)
  isFundraising         Boolean             @default(false)
  verificationStatus    VerificationStatus  @default(UNVERIFIED)
  verifiedAt            DateTime? // set by VerificationEngineService when verificationStatus automatically reaches VERIFIED — see modules/verification
  isPublic              Boolean             @default(true)
  visibility            ProfileVisibility   @default(PUBLIC) // finer-grained than isPublic — see StartupPublicProjectionService
  metricsVisibility     MetricVisibility    @default(BAND)
  termsAcceptedAt       DateTime? // Step 10 "Accept Terms" — e-signature is the typed founder name + this timestamp
  publishedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt              DateTime?

  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamMembers StartupTeamMember[]
  product     StartupProduct?
  market      StartupMarket?
  traction    StartupTraction?
  funding     StartupFunding?
  preference  StartupPreference?
  connections Connection[]
  milestones  StartupMilestone[]
  followedBy  StartupFollow[]
  profileViews StartupProfileView[]
  pipelineEntries PipelineEntry[]
  investments Investment[]
  mentorBookingRequests MentorBookingRequest[]
  jobs        Job[]
  posts       Post[]
  metricObservations MetricObservation[]
  fundingRounds      FundingRound[]
  watchlistTriggers  WatchlistTrigger[]

  @@index([industry])
  @@index([stage])
  @@index([isFundraising])
  @@index([isPublic, verificationStatus]) // backs the public discovery feed's primary filter
  @@map("startups")
}

// Founder-curated milestones ("Idea Created" -> "Product Launch") shown on the
// public profile in chronological order and counted as one TrustScore factor.
model StartupMilestone {
  id           String        @id @default(uuid()) @db.Uuid
  startupId    String        @db.Uuid
  type         MilestoneType
  title        String
  description  String?
  achievedAt   DateTime
  evidenceUrls String[]      @default([]) // optional photos/links/documents — type is a rendering concern (sniff by extension), not storage, mirrors Post.mediaUrls
  createdAt    DateTime      @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, achievedAt])
  @@map("startup_milestones")
}

model StartupTeamMember {
  id          String              @id @default(uuid()) @db.Uuid
  startupId   String              @db.Uuid
  category    TeamMemberCategory  @default(EMPLOYEE)
  fullName    String
  role        String // job title, free text
  linkedinUrl String?
  photoUrl    String?
  createdAt   DateTime            @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("startup_team_members")
}

// Step 3 — Product Details. 1:1 with Startup; split out because it's a distinct, optional-until-MVP concern.
model StartupProduct {
  id                String   @id @default(uuid()) @db.Uuid
  startupId         String   @unique @db.Uuid
  productName       String?
  description       String?
  currentVersion    String?
  website           String?
  appStoreUrl       String?
  playStoreUrl      String?
  demoVideoUrl      String?
  pitchVideoUrl     String?
  screenshots       String[]
  technologyStack   String[]
  hasApi            Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_products")
}

// Step 4 — Market Details. Personas/competitors are semi-structured lists — JSON keeps the schema stable as their shape evolves.
model StartupMarket {
  id                    String          @id @default(uuid()) @db.Uuid
  startupId             String          @unique @db.Uuid
  targetAudience        String?
  targetGeography       String[]
  primaryCustomer       String?
  customerModel         CustomerModel[]
  currency              Currency        @default(INR)
  tamAmount             Decimal?        @db.Decimal(16, 2)
  samAmount             Decimal?        @db.Decimal(16, 2)
  somAmount             Decimal?        @db.Decimal(16, 2)
  customerPersonas      Json?
  competitors           Json?
  competitiveAdvantage  String?
  goToMarketStrategy    String?
  updatedAt             DateTime        @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_markets")
}

// Step 6 — Traction.
model StartupTraction {
  id                    String   @id @default(uuid()) @db.Uuid
  startupId             String   @unique @db.Uuid
  currency              Currency @default(INR)
  monthlyRevenueAmount  Decimal? @db.Decimal(14, 2)
  arrAmount             Decimal? @db.Decimal(14, 2)
  mrrAmount             Decimal? @db.Decimal(14, 2)
  totalUsers            Int?
  totalCustomers        Int?
  downloads             Int?
  retentionRatePercent  Decimal? @db.Decimal(5, 2)
  growthRatePercent     Decimal? @db.Decimal(6, 2)
  partnerships          String[]
  awards                String[]
  patents               String[]
  mediaMentions         String[]
  updatedAt             DateTime @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_tractions")
}

// Step 7 — Funding.
model StartupFunding {
  id                  String        @id @default(uuid()) @db.Uuid
  startupId           String        @unique @db.Uuid
  fundingTypes        FundingType[]
  currency            Currency      @default(INR)
  currentRaiseAmount  Decimal?      @db.Decimal(14, 2)
  fundingGoalAmount   Decimal?      @db.Decimal(14, 2)
  valuationAmount     Decimal?      @db.Decimal(16, 2)
  previousInvestors   String[]
  useOfFunds          String?
  runwayMonths        Int?
  monthlyBurnRateAmount Decimal?    @db.Decimal(14, 2)
  updatedAt           DateTime      @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_fundings")
}

// Bundle 12 — one row per historical round (not overwritten), so total
// raised and dilution history can be computed rather than typed once.
// `closedAt` and other fields are founder-declared (V1) today; dates become
// V3-MCA-verified once the MCA provider (Phase 2 registry) is wired for real.
model FundingRound {
  id                  String             @id @default(uuid()) @db.Uuid
  startupId           String             @db.Uuid
  roundType           FundingType
  instrument          FundingInstrument
  currency            Currency           @default(INR)
  amount              Decimal            @db.Decimal(16, 2)
  preMoneyValuation   Decimal?           @db.Decimal(16, 2)
  postMoneyValuation  Decimal?           @db.Decimal(16, 2)
  leadInvestorName    String?
  dilutionPercent     Decimal?           @db.Decimal(5, 2)
  closedAt            DateTime           @db.Date
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, closedAt])
  @@map("funding_rounds")
}

// Step 9 — Preferences ("Looking For").
model StartupPreference {
  id         String           @id @default(uuid()) @db.Uuid
  startupId  String           @unique @db.Uuid
  lookingFor LookingForType[]
  updatedAt  DateTime         @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_preferences")
}

// A startup's own job postings — separate from the `jobs` BullMQ email
// queue module of the same informal name; this is the hiring-portal domain.
model Job {
  id             String         @id @default(uuid()) @db.Uuid
  startupId      String         @db.Uuid
  title          String
  description    String
  employmentType EmploymentType
  location       String
  isRemote       Boolean        @default(false)
  skills         String[]
  currency       Currency       @default(INR)
  minSalaryAmount Decimal?      @db.Decimal(12, 2)
  maxSalaryAmount Decimal?      @db.Decimal(12, 2)
  status         JobStatus      @default(OPEN)
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  startup      Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([startupId])
  @@index([status])
  @@map("jobs_board_postings")
}

// `resumeUrl`/`coverLetter` are captured on the row at apply-time rather than
// joined from JobSeekerProfile — mirrors Connection.pitchDeckUrl's precedent,
// so applying never requires completed JOB_SEEKER onboarding.
model JobApplication {
  id           String            @id @default(uuid()) @db.Uuid
  jobId        String            @db.Uuid
  applicantId  String            @db.Uuid
  resumeUrl    String
  coverLetter  String?
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@map("job_applications")
}

// ─── Other role profiles ────────────────────────────────────────────────

model Investor {
  id                  String         @id @default(uuid()) @db.Uuid
  ownerId             String         @unique @db.Uuid
  firmName            String?
  designation         String?
  investorType        InvestorType
  bio                 String
  logoUrl             String?
  website             String?
  currency            Currency       @default(INR)
  checkSizeMinAmount  Decimal        @default(0) @db.Decimal(14, 2)
  checkSizeMaxAmount  Decimal        @default(0) @db.Decimal(14, 2)
  preferredStages     StartupStage[]
  preferredIndustries String[]
  preferredGeography  String[]
  portfolioCompanies  String[]
  investmentThesis    String?
  openForPitches      Boolean        @default(true)
  location            String
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verifiedAt          DateTime? // set by VerificationEngineService — see modules/verification
  isPublic            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([investorType])
  @@index([isPublic, verificationStatus])
  @@map("investors")
}

// ─── Investor Workspace ─────────────────────────────────────────────────

// A named, reusable thesis — an investor can run several at once (e.g.
// "Seed SaaS India" and "Fintech Series A"), each producing its own match
// stream. Deliberately separate from Investor.preferred* (a single default
// thesis, used as the fallback for plain discovery/matchMyPreferences) —
// mandates are the multi-thesis layer on top.
model InvestmentMandate {
  id               String          @id @default(uuid()) @db.Uuid
  investorId       String          @db.Uuid
  name             String
  industries       Industry[]
  stages           StartupStage[]
  currency         Currency        @default(INR)
  chequeMinAmount  Decimal?        @db.Decimal(14, 2)
  chequeMaxAmount  Decimal?        @db.Decimal(14, 2)
  geography        String[]
  revenueStatuses  RevenueStatus[]
  minTrustBand     TrustBand?
  raisingOnly      Boolean         @default(false)
  requireVerified  Boolean         @default(false)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  investor User            @relation(fields: [investorId], references: [id], onDelete: Cascade)
  pipelineEntries PipelineEntry[]

  @@index([investorId, isActive])
  @@map("investment_mandates")
}

model MentorProfile {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerId            String        @unique @db.Uuid
  headline           String?
  expertise          String[]
  industries         String[]
  yearsExperience    Int?
  availability       String?
  sessionTypes       SessionType[]
  pricingModel       String? // e.g. "Free", "$150/hr", "Equity-based"
  languages          String[]
  pastStartups       String[] // free-text company names — often off-platform, so not an FK relation
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime? // set by VerificationEngineService — see modules/verification
  isPublic           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([isPublic, verificationStatus])
  @@map("mentor_profiles")
}

model IncubatorProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  ownerId               String   @unique @db.Uuid
  organizationName      String
  description           String?
  website               String?
  logoUrl               String?
  industries            String[]
  portfolioCompanies    String[]
  affiliatedMentorCount Int?
  kind                  IncubatorKind @default(INCUBATOR) // lets Accelerators surface as a filter on this same directory, no separate entity
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime? // set by VerificationEngineService — see modules/verification
  isPublic              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  programs IncubatorProgram[]

  @@index([isPublic, verificationStatus])
  @@map("incubator_profiles")
}

model IncubatorProgram {
  id                    String    @id @default(uuid()) @db.Uuid
  incubatorId           String    @db.Uuid
  name                  String
  description           String?
  durationWeeks         Int?
  applicationCycleStart DateTime?
  applicationCycleEnd   DateTime?
  applicationUrl        String? // external link founders click through to apply — no in-app application flow yet
  eligibilityCriteria   String?
  createdAt             DateTime  @default(now())

  incubator IncubatorProfile @relation(fields: [incubatorId], references: [id], onDelete: Cascade)

  @@index([incubatorId])
  @@map("incubator_programs")
}

// A founder requesting time with a mentor — deliberately not a Connection:
// no monthly quota, repeatable per pair, no messaging/meeting gate. See
// MentorBookingService.
model MentorBookingRequest {
  id             String        @id @default(uuid()) @db.Uuid
  founderId      String        @db.Uuid
  mentorId       String        @db.Uuid
  startupId      String?       @db.Uuid
  sessionType    SessionType?
  message        String
  preferredTimes String?
  status         BookingStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())

  founder User     @relation("MentorBookingFounder", fields: [founderId], references: [id], onDelete: Cascade)
  mentor  User     @relation("MentorBookingMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  startup Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)
  review  FounderReview?
  mentorReview MentorReview?

  @@index([mentorId, status])
  @@index([founderId])
  @@map("mentor_booking_requests")
}

// A mentor's review of a founder after an accepted booking — feeds
// FounderReputationService. Gated on the booking being ACCEPTED (not a
// separate COMPLETED state — there's no real session-datetime field to gate
// true completion on yet); the unique constraint on bookingRequestId is what
// stops a mentor reviewing the same booking twice.
model FounderReview {
  id               String   @id @default(uuid()) @db.Uuid
  mentorId         String   @db.Uuid
  founderId        String   @db.Uuid
  bookingRequestId String   @unique @db.Uuid
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())

  mentor         User                  @relation("FounderReviewMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  founder        User                  @relation("FounderReviewFounder", fields: [founderId], references: [id], onDelete: Cascade)
  bookingRequest MentorBookingRequest  @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@map("founder_reviews")
}

// The other direction — spec §5: "after each real, accepted mentoring
// session, the founder rates the mentor (1-5 + comment)... the rating can
// only be left after a genuine booking, so it can't be faked." This is what
// MentorReputationService reads to compute a mentor's average rating and
// session count; deliberately a separate table from FounderReview (which
// feeds the opposite axis, Founder Reputation) — same booking can carry
// both, one review per direction.
model MentorReview {
  id               String   @id @default(uuid()) @db.Uuid
  mentorId         String   @db.Uuid
  founderId        String   @db.Uuid
  bookingRequestId String   @unique @db.Uuid
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())

  mentor         User                 @relation("MentorReviewMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  founder        User                 @relation("MentorReviewFounder", fields: [founderId], references: [id], onDelete: Cascade)
  bookingRequest MentorBookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_reviews")
}

model UniversityProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  ownerId             String   @unique @db.Uuid
  institutionName     String
  affiliationType     String? // "Public" | "Private" | free text
  website             String?
  logoUrl             String?
  incubationCellName  String?
  departments         String[]
  programsOffered     String[]
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  isPublic            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([isPublic, verificationStatus])
  @@map("university_profiles")
}

model ServiceProviderProfile {
  id                 String            @id @default(uuid()) @db.Uuid
  ownerId            String            @unique @db.Uuid
  companyName        String
  categories         ServiceCategory[]
  description        String?
  pricingModel       String?
  yearsExperience    Int?
  clientsServed      Int?
  website            String?
  logoUrl            String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isPublic           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([isPublic, verificationStatus])
  @@map("service_provider_profiles")
}

model JobSeekerProfile {
  id                    String            @id @default(uuid()) @db.Uuid
  ownerId               String            @unique @db.Uuid
  headline              String?
  resumeUrl             String?
  skills                String[]
  preferredRoles        String[]
  currency              Currency          @default(INR)
  expectedSalaryMinAmount Decimal?        @db.Decimal(12, 2)
  expectedSalaryMaxAmount Decimal?        @db.Decimal(12, 2)
  availability          AvailabilityType  @default(FLEXIBLE)
  isPublic              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  owner      User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  experience WorkExperienceEntry[]
  education  EducationEntry[]

  @@map("job_seeker_profiles")
}

model WorkExperienceEntry {
  id           String    @id @default(uuid()) @db.Uuid
  jobSeekerId  String    @db.Uuid
  company      String
  title        String
  startDate    DateTime?
  endDate      DateTime?
  description  String?

  jobSeeker JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@index([jobSeekerId])
  @@map("work_experience_entries")
}

model EducationEntry {
  id           String  @id @default(uuid()) @db.Uuid
  jobSeekerId  String  @db.Uuid
  institution  String
  degree       String?
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?

  jobSeeker JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@index([jobSeekerId])
  @@map("education_entries")
}

// ─── Platform ────────────────────────────────────────────────────────────

// The "Smart Connect Request" — a founder can never message an investor
// directly; this is the only channel, and it's rate-limited per calendar
// month by PlanLimit.monthlyConnectRequestLimit. Chat (Message, below) only
// unlocks once status flips to ACCEPTED. See docs/12-connect-requests.md.
model Connection {
  id                   String           @id @default(uuid()) @db.Uuid
  requesterId          String           @db.Uuid
  recipientId          String           @db.Uuid
  startupId            String?          @db.Uuid
  status               ConnectionStatus @default(PENDING)
  introduction         String? // short intro + startup summary, written by the requester
  currency             Currency         @default(INR)
  fundingRequirementAmount Int?
  pitchDeckUrl         String?
  executiveSummaryUrl  String?
  demoLinkUrl          String?
  infoRequestedAt      DateTime? // investor asked for more detail before deciding — doesn't change status, just flags it on the founder's side
  createdAt            DateTime         @default(now())
  respondedAt          DateTime?

  requester User      @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User      @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  startup   Startup?  @relation(fields: [startupId], references: [id], onDelete: SetNull)
  messages  Message[]
  meetings  Meeting[]

  @@unique([requesterId, recipientId, startupId]) // prevents duplicate pending requests
  @@index([recipientId, status])
  @@map("connections")
}

// A lightweight proposed meeting time attached to a connection — no calendar
// sync or video-call provider integration yet (see CLAUDE.md future-modules
// note); `videoCallUrl` is whatever link the two parties paste in themselves.
model Meeting {
  id           String    @id @default(uuid()) @db.Uuid
  connectionId String    @db.Uuid
  scheduledAt  DateTime
  notes        String?
  videoCallUrl String?
  createdAt    DateTime  @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("meetings")
}

// A founder's own bookmark ("Saved") vs. an active follow that triggers
// update notifications ("Watchlist") are the same relationship with one flag
// — see WatchlistService for how milestone/product/funding events fan out
// to `notifyOnUpdate: true` followers only.
model StartupFollow {
  id             String   @id @default(uuid()) @db.Uuid
  investorId     String   @db.Uuid
  startupId      String   @db.Uuid
  notifyOnUpdate Boolean  @default(false)
  notes          String? // private investor note about this startup
  listName       String? // free-text grouping label — a lightweight "list" without a separate collections table
  createdAt      DateTime @default(now())

  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  startup  Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([investorId, startupId])
  @@map("startup_follows")
}

// The Watchlist's retention-engine half — "notify me when X happens to this
// startup." Evaluated by a recurring BullMQ job (WatchlistTriggersProcessor),
// which fires each trigger at most once (`firedAt` set) and creates a real
// Notification through the existing NotificationsService — no separate
// alert-delivery mechanism. `baselineValue` snapshots a starting number
// (team size, patent count) at creation time for "doubled"/"increased" types.
enum WatchlistTriggerType {
  REVENUE_ABOVE
  TRUST_BAND_REACHES
  GST_VERIFIED
  MCA_VERIFIED
  FUNDING_ROUND_OPENED
  HEADCOUNT_DOUBLED
  NEW_FOUNDER_ADDED
  VERIFICATION_COMPLETED
  NEW_METRICS_UPLOADED
  NEW_CAP_TABLE_INVESTOR
  PRODUCT_LAUNCHED
  PATENT_GRANTED
  MILESTONE_POSTED
}

model WatchlistTrigger {
  id              String               @id @default(uuid()) @db.Uuid
  investorId      String               @db.Uuid
  startupId       String               @db.Uuid
  type            WatchlistTriggerType
  thresholdAmount Decimal?             @db.Decimal(16, 2)
  thresholdBand   TrustBand?
  baselineValue   Int?
  isActive        Boolean              @default(true)
  firedAt         DateTime?
  createdAt       DateTime             @default(now())

  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  startup  Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([startupId, isActive, firedAt])
  @@map("watchlist_triggers")
}

// A saved discovery filter set — "Seed SaaS India", "Fintech Raising" (spec
// §5). `filters` stores the exact same shape as StartupSearchFilters (JSON,
// since it's an arbitrary combination of optional fields); re-running a
// saved search means feeding that JSON straight back into
// StartupsService.search — no separate query builder. `lastViewedAt` is what
// "N new startups matching" is computed against.
model SavedSearch {
  id           String   @id @default(uuid()) @db.Uuid
  investorId   String   @db.Uuid
  name         String
  filters      Json
  notify       Boolean  @default(false)
  lastViewedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investor User @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@map("saved_searches")
}

// Generic user-to-user follow (follow a founder, an investor, a mentor…) —
// deliberately separate from StartupFollow, which is investor→startup with
// its own notifyOnUpdate/watchlist semantics. This is the plain "follow a
// person" mechanism network-effects features build on.
model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// Day-bucketed view log — `viewDate` (date-only) + the unique constraint is
// the throttle: one row per investor per startup per calendar day, repeat
// same-day views just increment `viewCount` rather than inserting, and only
// the first view of a new day emits a `startup.profile-viewed` event, so a
// founder never gets spammed by one investor refreshing the page repeatedly.
model StartupProfileView {
  id         String   @id @default(uuid()) @db.Uuid
  startupId  String   @db.Uuid
  investorId String   @db.Uuid
  viewDate   DateTime @db.Date
  viewCount  Int      @default(1)
  createdAt  DateTime @default(now())

  startup  Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([startupId, investorId, viewDate])
  @@index([startupId, viewDate])
  @@map("startup_profile_views")
}

// One row per (investor, startup) the investor is actively evaluating —
// the Kanban board is just this table grouped by `stage`. Reaching INVESTED
// auto-creates the matching Investment row (see PipelineService.moveStage).
model PipelineEntry {
  id           String        @id @default(uuid()) @db.Uuid
  investorId   String        @db.Uuid
  startupId    String        @db.Uuid
  mandateId    String?       @db.Uuid // which thesis sourced this — null for entries added outside any mandate
  stage        PipelineStage @default(SOURCED)
  notes        String?
  passReason   PassReason?
  passNote     String?
  passedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt // doubles as "last activity" — every stage/notes change touches this

  investor User               @relation(fields: [investorId], references: [id], onDelete: Cascade)
  startup  Startup            @relation(fields: [startupId], references: [id], onDelete: Cascade)
  mandate  InvestmentMandate? @relation(fields: [mandateId], references: [id], onDelete: SetNull)

  @@unique([investorId, startupId])
  @@index([investorId, stage])
  @@map("pipeline_entries")
}

// The investor's actual portfolio — created once a PipelineEntry reaches
// INVESTED; "Current Stage", "Revenue", "Team Size" for the portfolio card
// are read live off the Startup/StartupTraction rows, not duplicated here.
model Investment {
  id         String    @id @default(uuid()) @db.Uuid
  investorId String    @db.Uuid
  startupId  String    @db.Uuid
  investedAt      DateTime  @default(now())
  currency        Currency  @default(INR)
  amount          Decimal?  @db.Decimal(14, 2)
  notes           String?
  // Exit tracking (Investor Workspace §9 — Active/Exited, Realised/Unrealised).
  // Null exitedAt = still active. Deliberately minimal — full Exit Readiness
  // (Bundle 27: acquirers, comparable exits, liquidation stack) is out of
  // scope here; this is just enough structure to record a real exit.
  exitedAt        DateTime?
  exitValueAmount Decimal?  @db.Decimal(16, 2)
  nextFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())

  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  startup  Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([investorId, startupId])
  @@map("investments")
}

// Unlocked only once its parent Connection is ACCEPTED — see
// MessagesService.assertCanMessage. Deliberately simple (no threads,
// reactions, or read receipts) since real-time chat infra isn't in scope yet.
model Message {
  id           String    @id @default(uuid()) @db.Uuid
  connectionId String    @db.Uuid
  senderId     String    @db.Uuid
  body         String
  attachmentUrl String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("messages")
}

// Admin-configurable quota per plan (e.g. Free founders get N connect
// requests/month) — a row missing for a given plan means "not yet
// configured"; services fall back to a hardcoded default rather than
// failing, see PlanLimitsService.
model PlanLimit {
  id                         String           @id @default(uuid()) @db.Uuid
  plan                       SubscriptionPlan @unique
  monthlyConnectRequestLimit Int? // null = unlimited
  updatedAt                  DateTime         @updatedAt

  @@map("plan_limits")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Community ──────────────────────────────────────────────────────────

// One table + a type discriminator, not four separate models — FOUNDER_POST/
// STARTUP_UPDATE/ANNOUNCEMENT are structurally identical (author + optional
// startup context + body + media); an Event is "a Post with 3 extra optional
// fields," not a structurally different entity. Poll/Event get their own
// *child* tables (PollOption/PollVote, EventRsvp) because they have real
// structured child data the other types don't.
model Post {
  id            String   @id @default(uuid()) @db.Uuid
  authorId      String   @db.Uuid
  startupId     String?  @db.Uuid
  type          PostType
  body          String
  mediaUrls     String[]
  eventStartsAt DateTime?
  eventLocation String?
  eventUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  startup     Startup?      @relation(fields: [startupId], references: [id], onDelete: SetNull)
  comments    Comment[]
  likes       Like[]
  pollOptions PollOption[]
  rsvps       EventRsvp[]
  bookmarks   PostBookmark[]

  @@index([type, createdAt])
  @@index([authorId])
  @@map("posts")
}

// Flat, single-level — no nested replies, matches "keep it simple, no algorithmic ranking."
model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  Like[]

  @@index([postId, createdAt])
  @@map("comments")
}

// Two nullable FKs with onDelete: Cascade — real referential integrity
// (unlike AuditLog's stringly-typed entityType/entityId, which intentionally
// avoids cascade). Service layer enforces exactly one of postId/commentId set.
model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String?  @db.Uuid
  commentId String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model PostBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_bookmarks")
}

model PollOption {
  id    String @id @default(uuid()) @db.Uuid
  postId String @db.Uuid
  label String
  order Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([postId])
  @@map("poll_options")
}

// One-vote-per-poll-per-user is an app-level invariant (checked via a join
// through PollOption.postId before insert) — a plain unique on
// [userId, pollOptionId] alone wouldn't stop a user voting for two different
// options in the same poll.
model PollVote {
  id           String   @id @default(uuid()) @db.Uuid
  pollOptionId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())

  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pollOptionId])
  @@map("poll_votes")
}

model EventRsvp {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("event_rsvps")
}

// ─── Billing ────────────────────────────────────────────────────────────

model Subscription {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @unique @db.Uuid
  plan                 SubscriptionPlan @default(FREE)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Foundation: metrics, verification, trust (Phase 1) ─────────────────

// Every metric that changes over time (revenue, users, headcount, valuation)
// is stored as dated history here, never overwritten in place — CLAUDE.md §
// "every metric... is stored as dated history". `source` records where the
// value came from ("self-declared" | "razorpay" | "google-analytics" | ...)
// and `verificationTier` records how much to trust it (V0 = just typed).
model MetricObservation {
  id               String           @id @default(uuid()) @db.Uuid
  startupId        String           @db.Uuid
  metricKey        MetricKey
  value            Decimal          @db.Decimal(18, 2)
  currency         Currency? // set only for money-denominated metrics (revenue, ARR, valuation, funding raised)
  periodStart      DateTime         @db.Date
  periodEnd        DateTime?        @db.Date
  source           String
  verificationTier VerificationTier @default(V0)
  recordedAt       DateTime         @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, metricKey, periodStart])
  @@map("metric_observations")
}

// The record of what's been proven, by whom, when, and until when — applies
// to every fact about every user type (startup, investor, mentor, incubator,
// university, service provider), so it's polymorphic (entityType/entityId)
// rather than FK-tied to one table, same pattern as AuditLog below.
// `rawResponse` retains the raw registry/provider response permanently for
// audit, per spec. A failed verification is a row with status=FAILED, never
// a silently missing row — see CLAUDE.md §6/§7 ("not disclosed", not hidden).
model VerificationRecord {
  id          String                   @id @default(uuid()) @db.Uuid
  entityType  String // "Startup" | "Investor" | "MentorProfile" | "IncubatorProfile" | "UniversityProfile" | "ServiceProviderProfile" | "User"
  entityId    String                   @db.Uuid
  field       String // e.g. "legalName", "gstin", "dpiitNumber", "identity", "portfolioCompany:<startupId>"
  tier        VerificationTier
  method      String // e.g. "MCA_API", "GSTIN_API", "SEBI_API", "DOMAIN_EMAIL", "OTP_PHONE", "TWO_SIDED_CONFIRMATION"
  status      VerificationRecordStatus @default(PENDING)
  verifiedAt  DateTime?
  expiresAt   DateTime? // verification always expires — re-checked, never assumed permanent
  verifiedBy  String? // verifier service name ("system:mca-verifier") or admin user id
  confidence  Decimal?                 @db.Decimal(3, 2)
  rawResponse Json? // permanent audit copy of the raw registry/provider response
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([entityType, entityId, field])
  @@index([status, expiresAt])
  @@map("verification_records")
}

// A claim about a relationship between two entities, confirmed or denied by
// the OTHER party — spec §9 (two-sided confirmation), the free/unfakeable
// mechanism that grows the network as a by-product. An unconfirmed claim
// counts for zero trust; only CONFIRMED claims feed a VerificationRecord (V2,
// method TWO_SIDED_CONFIRMATION) for both sides — see RelationshipClaimsService.
// Polymorphic on both ends (same pattern as VerificationRecord/AuditLog) since
// a claim can run Investor<->Startup, IncubatorProfile<->Startup, etc.
model RelationshipClaim {
  id               String           @id @default(uuid()) @db.Uuid
  claimantType     String // "Investor" | "IncubatorProfile" | "UniversityProfile" | "Startup"
  claimantId       String           @db.Uuid
  targetType       String
  targetId         String           @db.Uuid
  relationshipType RelationshipType
  status           ClaimStatus      @default(PENDING)
  note             String? // optional context from the claimant (e.g. round name, program batch)
  evidenceUrl      String?
  respondedBy      String?          @db.Uuid // userId of whoever on the target side confirmed/denied
  createdAt        DateTime         @default(now())
  respondedAt      DateTime?

  @@index([claimantType, claimantId])
  @@index([targetType, targetId, status])
  @@map("relationship_claims")
}

// Persisted, historical Trust Score — every user type gets one (spec: even
// investors are scored, on response rate / verification). Polymorphic for
// the same reason as VerificationRecord. `breakdown` mirrors the component
// shape produced by trust-model.ts so the UI can render "why this score."
model TrustScoreSnapshot {
  id         String    @id @default(uuid()) @db.Uuid
  entityType String // "Startup" | "Investor" | "MentorProfile" | "IncubatorProfile" | "UniversityProfile" | "ServiceProviderProfile"
  entityId   String    @db.Uuid
  score      Int
  band       TrustBand
  breakdown  Json
  computedAt DateTime  @default(now())

  @@index([entityType, entityId, computedAt])
  @@map("trust_score_snapshots")
}

// ─── Compliance ─────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid // null for system-initiated actions
  action     String // e.g. "startup.verified", "user.role_changed", "auth.login"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
